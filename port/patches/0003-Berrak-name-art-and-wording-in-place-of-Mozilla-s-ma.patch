--- /dev/null
+++ b/mobile/android/focus-android/tools/berrak/rebrand_strings.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+"""Apply Berrak's string changes to focus-android's resources.
+
+Each key in OVERRIDES gets Berrak's English text in values/strings.xml, and
+its translations are deleted from every values-*/strings.xml, so all locales
+fall back to that English text rather than keep a translated claim that is
+wrong for Berrak (for example "produced by Mozilla").
+
+Idempotent: run it again after every rebase onto a new Focus release. It
+fails loudly when a key has disappeared upstream, so a renamed string is
+noticed instead of silently left in Mozilla's wording.
+
+Usage: python3 tools/berrak/rebrand_strings.py  (from mobile/android/focus-android)
+"""
+
+import pathlib
+import re
+import sys
+
+RES = pathlib.Path(__file__).resolve().parents[2] / "app" / "src" / "main" / "res"
+
+OVERRIDES = {
+    # Selected-text action shown in other apps; cannot use a variable.
+    "text_selection_search_action_klar": "Search in Berrak",
+    "about_content": """<![CDATA[<p>%1$s puts you in control.</p>
+<p>Use it as a private browser:
+  <ul>
+    <li>Search and browse right in the app</li>
+    <li>Block trackers (or update settings to allow trackers)</li>
+    <li>Erase to delete cookies as well as search and browsing history</li>
+  </ul>
+</p>
+<p>%1$s is an independent fork of Mozilla’s open-source Firefox Focus, extended to browse httpx:// pages: HTTP over XMPP (XEP-0332). It is not produced or endorsed by Mozilla.<br/>
+<a href="%2$s">Learn more</a></p>]]>""",
+    # Settings section that holds about/help/licences.
+    "preference_category_mozilla": "Berrak",
+    # The data-choices section is removed (no telemetry).
+    "preference_privacy_and_security_summary": "Tracking, cookies",
+    # Onboarding: Berrak has no terms of use of its own and sends no data.
+    # These are formatted with the link as their only argument, so the app
+    # name is written out.
+    "onboarding_first_screen_terms_of_use_text_2": "Berrak is free software under the %1$s.",
+    "onboarding_first_screen_terms_of_use_link_2": "Mozilla Public License 2.0",
+    "onboarding_first_screen_privacy_notice_text_2": "Berrak sends nothing to anyone. Learn more in its %1$s.",
+    # The checkbox is hidden (no crash submit service); keep it honest anyway.
+    "crash_report_send_crash_label": "Send crash report",
+}
+
+STRING_RE = r'(<string name="{key}"[^>]*>)(.*?)(</string>)'
+
+
+def replace_english(text: str) -> str:
+    for key, value in OVERRIDES.items():
+        pattern = re.compile(STRING_RE.format(key=re.escape(key)), re.S)
+        if not pattern.search(text):
+            sys.exit(f"values/strings.xml has no string '{key}': upstream renamed it; update OVERRIDES")
+        text = pattern.sub(lambda m, v=value: m.group(1) + v + m.group(3), text, count=1)
+    return text
+
+
+def drop_translations(text: str) -> str:
+    for key in OVERRIDES:
+        # The element plus the comment directly above it, if any.
+        pattern = re.compile(
+            r'(?:[ \t]*<!--(?:(?!-->).)*-->\s*\n)?[ \t]*' + STRING_RE.format(key=re.escape(key)) + r'[ \t]*\n?',
+            re.S,
+        )
+        text = pattern.sub("", text)
+    return text
+
+
+def main() -> None:
+    english = RES / "values" / "strings.xml"
+    english.write_text(replace_english(english.read_text(encoding="utf-8")), encoding="utf-8")
+    changed = 0
+    for path in sorted(RES.glob("values-*/strings.xml")):
+        before = path.read_text(encoding="utf-8")
+        after = drop_translations(before)
+        if after != before:
+            path.write_text(after, encoding="utf-8")
+            changed += 1
+    print(f"English overrides: {len(OVERRIDES)}; locale files trimmed: {changed}")
+
+
+if __name__ == "__main__":
+    main()
