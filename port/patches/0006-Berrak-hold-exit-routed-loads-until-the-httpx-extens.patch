diff --git a/mobile/android/focus-android/app/src/main/java/org/mozilla/focus/httpx/HttpxExtension.kt b/mobile/android/focus-android/app/src/main/java/org/mozilla/focus/httpx/HttpxExtension.kt
index 98644c6eab..fe8baccdd2 100644
